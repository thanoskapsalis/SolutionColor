<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="SolutionColor.9e6abb40-3450-4778-a6b6-0a966d8709d6" Version="1.0.0" Language="en-US" Publisher="thanoskapsalis" />
    <DisplayName>Solution Color</DisplayName>
    <Description xml:space="preserve">Give every solution its own color. Colors the Visual Studio title bar and tints the Visual Studio icon (title bar logo, window/taskbar icon and a taskbar badge) per solution, so you can tell your open instances apart at a glance. Pick the color from the Solution node context menu: "Solution Color...".</Description>
    <License>LICENSE.txt</License>
    <Icon>Resources\Icon.png</Icon>
    <Tags>title bar, color, solution, theme, instance</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="SolutionColor.pkgdef" />
  </Assets>
</PackageManifest>